# Python virtual environment
.venv/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Jupyter
.ipynb_checkpoints/

# Environment variables
.env

# Raw and generated data
data/raw/*
data/cleaned/*
data/samples/*
data/output/*

# Keep folder placeholders
!data/raw/.gitkeep
!data/cleaned/.gitkeep
!data/samples/.gitkeep
!data/output/.gitkeep

# Results generated by jobs
results/output/*
results/tmp/*
!results/output/.gitkeep
!results/tmp/.gitkeep

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# IDE/editor
.vscode/
.idea/

# Hive local runtime files
hive/metastore_db/
hive/warehouse/
hive/conf/
spark-warehouse/
.derby/
metastore_db/
